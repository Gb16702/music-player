{
  "name": "music-player",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "test:web": "bun run --cwd apps/web test",
    "dev:api": "dotnet watch --project apps/api/src/MusicPlayer.Api",
    "build:api": "dotnet build apps/api/MusicPlayer.slnx",
    "test:api": "dotnet test apps/api/MusicPlayer.slnx",
    "generate:api-client": "openapi-ts",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "ci": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@hey-api/openapi-ts": "^0.99.0"
  }
}
